# AI-Powered Multimodal Construction Intelligence Platform - Backend Environment
# Copy this file to .env and fill in your own values. Never commit .env to source control.

# --- Application ---
APP_NAME=AI-Powered Multimodal Construction Intelligence Platform
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development

# --- Server ---
HOST=127.0.0.1
PORT=8000
# Allowed frontend origin for CORS. Change to match your deployed frontend.
FRONTEND_ORIGIN=http://localhost:5173

# --- Security / files ---
SECRET_KEY=change-me-to-a-random-secret
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,webp
UPLOAD_DIR=uploads
REPORTS_DIR=reports

# --- Database (SQLite) ---
DATABASE_URL=sqlite:///./construction_intelligence.db

# --- Groq / LLM ---
# Get your API key from https://console.groq.com (keep secret, backend only)
GROQ_API_KEY=your_groq_api_key_here
# Text-only model (chat/completion)
GROQ_MODEL_TEXT=llama-3.1-8b-instant
# Vision-capable model for image analysis (image + text). Set + enable below.
GROQ_MODEL_VISION=llama-3.2-11b-vision-preview
VISION_ENABLED=false
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
# Demo mode returns deterministic schema-valid sample responses when no credentials are available.
DEMO_MODE=true

# --- Weather (optional, OpenWeatherMap) ---
WEATHER_ENABLED=false
WEATHER_API_KEY=your_openweathermap_api_key_here
WEATHER_BASE_URL=https://api.openweathermap.org/data/2.5/weather
WEATHER_REQUEST_TIMEOUT_SECONDS=10
